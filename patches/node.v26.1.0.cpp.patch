 namespace node {
 namespace sea {
 
+namespace {
+
+constexpr size_t kSeaTailSizeLength = 8;
+constexpr size_t kSeaTailSentinelLength = sizeof(SEA_TAIL_SENTINEL) - 1;
+constexpr size_t kSeaTailTrailerLength =
+    kSeaTailSizeLength + kSeaTailSentinelLength;
+
+uint64_t ReadUint64LE(const char* data) {
+  uint64_t value = 0;
+  for (size_t i = 0; i < kSeaTailSizeLength; ++i) {
+    value |= static_cast<uint64_t>(static_cast<unsigned char>(data[i]))
+             << (8 * i);
+  }
+  return value;
+}
+
+void AppendUint64LE(std::vector<uint8_t>* data, uint64_t value) {
+  for (size_t i = 0; i < kSeaTailSizeLength; ++i) {
+    data->push_back(static_cast<uint8_t>((value >> (8 * i)) & 0xff));
+  }
+}
+
+std::string GetCurrentExecutablePath() {
+  for (size_t size = 1024; size <= 32768; size *= 2) {
+    std::vector<char> buffer(size);
+    size_t len = buffer.size();
+    int r = uv_exepath(buffer.data(), &len);
+    if (r == 0) {
+      return std::string(buffer.data(), len);
+    }
+    if (r != UV_ENOBUFS) {
+      return {};
+    }
+  }
+  return {};
+}
+
+std::vector<char> ReadFileRegion(const std::string& path,
+                                 int64_t offset,
+                                 size_t size) {
+  uv_fs_t req;
+  int r = uv_fs_open(nullptr, &req, path.c_str(), O_RDONLY, 0, nullptr);
+  uv_fs_req_cleanup(&req);
+  if (r < 0) {
+    return {};
+  }
+
+  uv_file file = static_cast<uv_file>(r);
+  std::vector<char> data(size);
+  uv_buf_t buf = uv_buf_init(data.data(), data.size());
+  r = uv_fs_read(nullptr, &req, file, &buf, 1, offset, nullptr);
+  uv_fs_req_cleanup(&req);
+
+  uv_fs_close(nullptr, &req, file, nullptr);
+  uv_fs_req_cleanup(&req);
+
+  if (r < 0 || static_cast<size_t>(r) != size) {
+    return {};
+  }
+
+  return data;
+}
+
+std::vector<char> ReadSingleExecutableBlobFromTail() {
+  std::string path = GetCurrentExecutablePath();
+  if (path.empty()) {
+    return {};
+  }
+
+  uv_fs_t req;
+  int r = uv_fs_stat(nullptr, &req, path.c_str(), nullptr);
+  if (r != 0) {
+    uv_fs_req_cleanup(&req);
+    return {};
+  }
+
+  int64_t file_size = req.statbuf.st_size;
+  uv_fs_req_cleanup(&req);
+  if (file_size < static_cast<int64_t>(kSeaTailTrailerLength)) {
+    return {};
+  }
+
+  int64_t trailer_offset = file_size - kSeaTailTrailerLength;
+  std::vector<char> trailer =
+      ReadFileRegion(path, trailer_offset, kSeaTailTrailerLength);
+  if (trailer.empty()) {
+    return {};
+  }
+
+  if (std::memcmp(trailer.data() + kSeaTailSizeLength,
+                  SEA_TAIL_SENTINEL,
+                  kSeaTailSentinelLength) != 0) {
+    return {};
+  }
+
+  uint64_t blob_size = ReadUint64LE(trailer.data());
+  if (blob_size >
+      static_cast<uint64_t>(file_size - kSeaTailTrailerLength)) {
+    return {};
+  }
+  if (blob_size >
+      static_cast<uint64_t>(std::numeric_limits<size_t>::max())) {
+    return {};
+  }
+
+  int64_t blob_offset =
+      trailer_offset - static_cast<int64_t>(blob_size);
+  return ReadFileRegion(path, blob_offset, static_cast<size_t>(blob_size));
+}
+
+std::string_view FindSingleExecutableBlobFromTail() {
+  static const std::vector<char> result = ReadSingleExecutableBlobFromTail();
+  if (result.empty()) {
+    return {};
+  }
+  return {result.data(), result.size()};
+}
